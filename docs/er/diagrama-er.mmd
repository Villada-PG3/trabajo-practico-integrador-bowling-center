erDiagram
    CLIENTE ||--o{ RESERVA : realiza
    PISTA ||--o{ RESERVA : "es reservada"
    RESERVA ||--|{ PARTIDA : registra
    RESERVA ||--o{ PEDIDO : genera
    PEDIDO ||--|{ DETALLE_PEDIDO : contiene
    PRODUCTO ||--o{ DETALLE_PEDIDO : "aparece en"
    PARTIDA ||--|{ PARTICIPACION : tiene
    JUGADOR ||--o{ PARTICIPACION : "participa en"
    PARTICIPACION ||--|{ TURNO : "se compone de"
    TURNO ||--|{ TIRO : "tiene"

    CLIENTE {
        int numero_cliente PK
        varchar nombre
        varchar direccion
        varchar telefono
        varchar email
    }

    PISTA {
        int numero_pista PK
        int capacidad_maxima
    }

    RESERVA {
        int numero_reserva PK
        int numero_cliente FK
        int numero_pista FK
        datetime fecha_hora_inicio
        datetime fecha_hora_fin
    }

    PRODUCTO {
        int id_producto PK
        varchar nombre
        varchar descripcion
        varchar tipo 
        decimal precio
    }

    PEDIDO {
        int id_pedido PK
        int numero_reserva FK
        datetime fecha_hora_pedido
    }

    DETALLE_PEDIDO {
        int id_detalle PK
        int id_pedido FK
        int id_producto FK
        int cantidad
        decimal precio_unitario 
    }

    PARTIDA {
        int id_partida PK
        int numero_reserva FK
        datetime fecha_hora_inicio
        datetime fecha_hora_fin
    }

    JUGADOR {
        int id_jugador PK
        varchar nombre
    }

    PARTICIPACION {
        int id_participacion PK
        int id_partida FK
        int id_jugador FK
        int puntaje_total 
    }

    TURNO {
        int id_turno PK
        int id_participacion FK
        int numero_turno
    }

    TIRO {
        int id_tiro PK
        int id_turno FK
        int numero_tiro
        int pinos_derribados
    }
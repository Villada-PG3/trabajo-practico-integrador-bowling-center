erDiagram
    CLIENTE ||--o{ RESERVA : realiza
    PISTA ||--o{ TARIFA_PISTA : tiene
    PISTA ||--o{ RESERVA : es_reservada
    TARIFA_PISTA ||--o{ RESERVA : se_aplica_en
    
    CLIENTE {
        int id_cliente PK
        string nombre
        string direccion
        string telefono
        string email
    }

    PISTA {
        int id_pista PK
        int capacidad_maxima
    }

    TARIFA_PISTA {
        int id_tarifa_pista PK
        int id_pista FK
        string dia_semana
        time hora_inicio_validez
        time hora_fin_validez
        date fecha_inicio_vigencia
        date fecha_fin_vigencia
        decimal precio_base
    }

    RESERVA {
        int id_reserva PK
        int id_cliente FK
        int id_pista FK
        int id_tarifa_aplicada FK
        date fecha_turno
        time hora_inicio_prevista
        time hora_fin_prevista
        int cantidad_jugadores
        decimal costo_total_calculado
        string estado
    }
